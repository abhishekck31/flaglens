{
  "name": "flaglens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "up": "docker compose up -d && node scripts/wait-for-flagsmith.mjs",
    "seed": "node scripts/seed.mjs",
    "demo": "npm --prefix apps/demo-store run dev",
    "build:demo": "npm --prefix apps/demo-store run build",
    "build": "npm --prefix packages/flaglens-vscode run build",
    "test": "npm --prefix packages/flaglens-vscode test",
    "typecheck": "npm --prefix packages/flaglens-vscode run typecheck",
    "package": "npm --prefix packages/flaglens-vscode run package"
  },
  "description": "FlagLens: a VS Code extension for self-hosted Flagsmith"
}

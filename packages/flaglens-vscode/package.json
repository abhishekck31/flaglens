{
  "name": "flaglens",
  "displayName": "FlagLens for Self-Hosted Flagsmith",
  "description": "See, toggle and track Flagsmith feature flags from VS Code. Built for self-hosted Flagsmith.",
  "version": "0.1.0",
  "publisher": "togglewars",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishekck31/flaglens",
    "directory": "packages/flaglens-vscode"
  },
  "homepage": "https://github.com/abhishekck31/flaglens#readme",
  "bugs": {
    "url": "https://github.com/abhishekck31/flaglens/issues"
  },
  "keywords": [
    "flagsmith",
    "feature flags",
    "feature toggles",
    "self-hosted",
    "codelens",
    "code references"
  ],
  "categories": [
    "Other",
    "Linters"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "flaglens.connect",
        "title": "Connect to Flagsmith",
        "category": "FlagLens"
      },
      {
        "command": "flaglens.disconnect",
        "title": "Disconnect (forget API key)",
        "category": "FlagLens"
      },
      {
        "command": "flaglens.refresh",
        "title": "Refresh",
        "category": "FlagLens",
        "icon": "$(refresh)"
      },
      {
        "command": "flaglens.toggleFlag",
        "title": "Toggle flag",
        "category": "FlagLens",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "flaglens.createFlag",
        "title": "Create flag in Flagsmith",
        "category": "FlagLens"
      },
      {
        "command": "flaglens.pushCodeReferences",
        "title": "Push code references to Flagsmith",
        "category": "FlagLens",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "flaglens.scanHealth",
        "title": "Rescan flag health",
        "category": "FlagLens",
        "icon": "$(refresh)"
      },
      {
        "command": "flaglens.removeFlag",
        "title": "Remove flag (keep enabled path)",
        "category": "FlagLens"
      },
      {
        "command": "flaglens.compareEnvironments",
        "title": "Compare environments",
        "category": "FlagLens",
        "icon": "$(diff)"
      },
      {
        "command": "flaglens.startLocalFlagsmith",
        "title": "Start local Flagsmith",
        "category": "FlagLens",
        "icon": "$(play)"
      },
      {
        "command": "flaglens.openDashboard",
        "title": "Open Flagsmith dashboard",
        "category": "FlagLens",
        "icon": "$(link-external)"
      },
      {
        "command": "flaglens.openDemoFile",
        "title": "Open demo file",
        "category": "FlagLens"
      }
    ],
    "configuration": {
      "title": "FlagLens",
      "properties": {
        "flaglens.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000/api/v1/",
          "description": "Base URL of your Flagsmith API, e.g. http://localhost:8000/api/v1/"
        },
        "flaglens.projectId": {
          "type": "number",
          "default": 0,
          "description": "Flagsmith project whose flags are shown in CodeLens. 0 means the first project."
        },
        "flaglens.callPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "hasFeature",
            "isFeatureEnabled",
            "getValue",
            "getFeatureValue",
            "getFlag",
            "useFlags"
          ],
          "description": "Function names whose first argument is a flag key (a string or an array of strings). Keys not found in Flagsmith get a warning. Add e.g. is_feature_enabled for Python."
        },
        "flaglens.dashboardUrl": {
          "type": "string",
          "default": "",
          "description": "Flagsmith dashboard URL for links in hover cards. Empty means the API URL without /api/v1 (right for the official docker-compose setup)."
        },
        "flaglens.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**",
            "**/.next/**",
            "**/test/**",
            "**/tests/**",
            "**/__tests__/**",
            "**/*.test.*",
            "**/*.spec.*",
            "**/*.md",
            "**/*.mdx",
            "stack/**",
            "scripts/**",
            "**/seed*"
          ],
          "markdownDescription": "Globs (relative to the repository root) of files that do not count as code references when pushing. Only git-tracked files are scanned, so `.gitignore` is always respected. `**` matches any folders, `*` anything within one name."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flaglens",
          "title": "FlagLens",
          "icon": "media/flaglens.svg"
        }
      ]
    },
    "views": {
      "flaglens": [
        {
          "id": "flaglens.flags",
          "name": "Flags"
        },
        {
          "id": "flaglens.health",
          "name": "Flag Health"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "flaglens.flags",
        "contents": "Connect to your self-hosted Flagsmith to see your flags here.\n[Connect to Flagsmith](command:flaglens.connect)\nNo Flagsmith yet? [Start local Flagsmith](command:flaglens.startLocalFlagsmith) or follow the [getting-started walkthrough](command:workbench.action.openWalkthrough?%22togglewars.flaglens%23gettingStarted%22).",
        "when": "!flaglens.connected"
      },
      {
        "view": "flaglens.health",
        "contents": "Connect to Flagsmith and open a folder in a git repository to see unused, missing and fully rolled-out flags.\n[Connect to Flagsmith](command:flaglens.connect)",
        "when": "!flaglens.connected"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flaglens.pushCodeReferences",
          "when": "view == flaglens.flags && flaglens.connected",
          "group": "navigation"
        },
        {
          "command": "flaglens.refresh",
          "when": "view == flaglens.flags",
          "group": "navigation"
        },
        {
          "command": "flaglens.scanHealth",
          "when": "view == flaglens.health",
          "group": "navigation"
        },
        {
          "command": "flaglens.compareEnvironments",
          "when": "view == flaglens.flags && flaglens.connected",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flaglens.toggleFlag",
          "when": "view == flaglens.flags && viewItem == flag",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "flaglens.toggleFlag",
          "when": "false"
        },
        {
          "command": "flaglens.createFlag",
          "when": "false"
        },
        {
          "command": "flaglens.removeFlag",
          "when": "false"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with FlagLens",
        "description": "Run self-hosted Flagsmith, connect, and see your flags in the editor.",
        "steps": [
          {
            "id": "start",
            "title": "Start local Flagsmith",
            "description": "Run the self-hosted stack with Docker and wait until it's healthy.\n[Start local Flagsmith](command:flaglens.startLocalFlagsmith)",
            "media": {
              "markdown": "media/walkthrough/start.md"
            },
            "completionEvents": [
              "onCommand:flaglens.startLocalFlagsmith"
            ]
          },
          {
            "id": "key",
            "title": "Get an Organisation API key",
            "description": "Sign up in the dashboard, then Organisation Settings → API Keys → Create API Key.\n[Open dashboard](command:flaglens.openDashboard)",
            "media": {
              "markdown": "media/walkthrough/key.md"
            },
            "completionEvents": [
              "onCommand:flaglens.openDashboard"
            ]
          },
          {
            "id": "connect",
            "title": "Connect FlagLens",
            "description": "Paste the key; FlagLens stores it in your OS keychain.\n[Connect](command:flaglens.connect)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:flaglens.connected"
            ]
          },
          {
            "id": "demo",
            "title": "Open the demo file",
            "description": "See CodeLens, hovers and the typo warning on real SDK calls.\n[Open demo file](command:flaglens.openDemoFile)",
            "media": {
              "markdown": "media/walkthrough/demo.md"
            },
            "completionEvents": [
              "onCommand:flaglens.openDemoFile"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.ts",
    "push": "node src/cli.ts push",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "check": "node src/cli.ts check"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}

{
  "name": "flaglens",
  "displayName": "FlagLens for Self-Hosted Flagsmith",
  "description": "See, toggle and track Flagsmith feature flags from VS Code. Built for self-hosted Flagsmith.",
  "version": "0.1.0",
  "publisher": "togglewars",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhishekck31/flaglens"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "flaglens.connect",
        "title": "Connect to Flagsmith",
        "category": "FlagLens"
      },
      {
        "command": "flaglens.disconnect",
        "title": "Disconnect (forget API key)",
        "category": "FlagLens"
      },
      {
        "command": "flaglens.refresh",
        "title": "Refresh",
        "category": "FlagLens",
        "icon": "$(refresh)"
      },
      {
        "command": "flaglens.toggleFlag",
        "title": "Toggle flag",
        "category": "FlagLens",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "flaglens.createFlag",
        "title": "Create flag in Flagsmith",
        "category": "FlagLens"
      }
    ],
    "configuration": {
      "title": "FlagLens",
      "properties": {
        "flaglens.apiUrl": {
          "type": "string",
          "default": "http://localhost:8000/api/v1/",
          "description": "Base URL of your Flagsmith API, e.g. http://localhost:8000/api/v1/"
        },
        "flaglens.projectId": {
          "type": "number",
          "default": 0,
          "description": "Flagsmith project whose flags are shown in CodeLens. 0 means the first project."
        },
        "flaglens.callPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "hasFeature",
            "isFeatureEnabled",
            "getValue",
            "getFeatureValue",
            "getFlag",
            "useFlags"
          ],
          "description": "Function names whose first argument is a flag key (a string or an array of strings). Keys not found in Flagsmith get a warning. Add e.g. is_feature_enabled for Python."
        },
        "flaglens.dashboardUrl": {
          "type": "string",
          "default": "",
          "description": "Flagsmith dashboard URL for links in hover cards. Empty means the API URL without /api/v1 (right for the official docker-compose setup)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flaglens",
          "title": "FlagLens",
          "icon": "media/flaglens.svg"
        }
      ]
    },
    "views": {
      "flaglens": [
        {
          "id": "flaglens.flags",
          "name": "Flags"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "flaglens.flags",
        "contents": "Connect to your self-hosted Flagsmith to see your flags here.\n[Connect to Flagsmith](command:flaglens.connect)",
        "when": "!flaglens.connected"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flaglens.refresh",
          "when": "view == flaglens.flags",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flaglens.toggleFlag",
          "when": "view == flaglens.flags && viewItem == flag",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "flaglens.toggleFlag",
          "when": "false"
        },
        {
          "command": "flaglens.createFlag",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
